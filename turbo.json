{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "SEMAPHORE",
    "SEMAPHORE_API_KEY",
    "SEMAPHORE_SENDER_NAME",
    "GMAIL_API_KEY",
    "GMAIL_SENDER_EMAIL",
    "GMAIL_CLIENT_ID",
    "GMAIL_CLIENT_SECRET",
    "GMAIL_REFRESH_TOKEN",
    "EMAIL_USER",
    "EMAIL_APP_PASSWORD",
    "EMAIL_PASSWORD",
    "EMAIL_FROM",
    "EMAIL_HOST",
    "EMAIL_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM",
    "SMTP_HOST",
    "SMTP_PORT",
    "JWT_SECRET",
    "SESSION_SECRET",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SITE_URL",
    "APP_URL",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
